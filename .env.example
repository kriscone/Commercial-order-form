# Deploy scripts/google-pricing-apps-script.gs as an Apps Script web app,
# then paste its /exec URL here.
GOOGLE_PRICING_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Stripe Payment Element for saving a card without charging at submission.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# Hosted environments may use this server-readable alias.
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
