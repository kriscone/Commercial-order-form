# Deploy scripts/google-pricing-apps-script.gs as an Apps Script web app,
# then paste its /exec URL here.
GOOGLE_PRICING_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Stripe Payment Element for saving a card without charging at submission.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# Hosted environments may use this server-readable alias.
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Server-to-server commercial order intake into OMS. Keep the shared key
# server-side; the browser only calls this app's /api/oms/commercial-order route.
OMS_API_URL=https://oms.example.com/api/v1
OMS_COMMERCIAL_ORDER_API_KEY=REPLACE_WITH_OMS_SHARED_KEY
OMS_COMMERCIAL_BRAND_KEY=floorplanonline
